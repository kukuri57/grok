#!/usr/bin/env python3
"""
Telegram → Grok Webhook 서명 프록시
텔레그램이 보내는 업데이트를 받아서 Standard Webhooks 서명을 붙여 그록으로 전달합니다.
"""
import os
import json
import hmac
import hashlib
import base64
import time
import uuid
from http.server import HTTPServer, BaseHTTPRequestHandler
import urllib.request

WEBHOOK_URL = os.environ.get("GROK_WEBHOOK_URL", "https://grok.com/webhook/automation/5e953af6-6479-4833-935e-f0ebbc702b13")
SECRET = os.environ.get("GROK_WEBHOOK_SECRET", "whsec_9NlIiV+auFQQu9vBjnulIXf+8/Ng1ROhlLmRtkb0VPQ=")
PORT = int(os.environ.get("PORT", 8080))

def sign_payload(body: bytes) -> dict:
    # whsec_ 접두사 제거 후 base64 디코드
    secret_bytes = base64.b64decode(SECRET.split("_", 1)[1])
    webhook_id = str(uuid.uuid4())
    timestamp = str(int(time.time()))
    to_sign = f"{webhook_id}.{timestamp}.".encode() + body
    signature = base64.b64encode(
        hmac.new(secret_bytes, to_sign, hashlib.sha256).digest()
    ).decode()
    return {
        "webhook-id": webhook_id,
        "webhook-timestamp": timestamp,
        "webhook-signature": f"v1,{signature}",
        "Content-Type": "application/json",
    }

class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length)
        headers = sign_payload(body)
        req = urllib.request.Request(WEBHOOK_URL, data=body, headers=headers, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                self.send_response(resp.status)
                self.end_headers()
                self.wfile.write(resp.read())
        except Exception as e:
            self.send_response(500)
            self.end_headers()
            self.wfile.write(str(e).encode())

    def do_GET(self):
        # 헬스체크용
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Telegram-Grok proxy is running")

if __name__ == "__main__":
    print(f"Proxy listening on 0.0.0.0:{PORT}")
    HTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
